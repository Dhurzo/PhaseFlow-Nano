{
  "name": "phaseflow-nano",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-agent system for OpenCode optimized for local models. Core is pure markdown agents with one optional model-inheritance plugin. No TypeScript build step required.",
  "scripts": {
    "test": "node --test tests/test-plugin.js tests/test-state-machine.js tests/test-tracker.js",
    "test:plugin": "node --test tests/test-plugin.js",
    "test:state": "node --test tests/test-state-machine.js",
    "test:tracker": "node --test tests/test-tracker.js"
  },
  "keywords": ["opencode", "multi-agent", "local-models", "phaseflow"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "model-inheritance": "file:.opencode/plugins/model-inheritance"
  }
}
